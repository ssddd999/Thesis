#include <Arduino.h>
#include "HX711.h"
#include <WiFi.h>
#include <WiFiClientSecure.h> 
#include <PubSubClient.h>
#include <WiFiManager.h> 

// ==========================================
// 1. CLOUD SETTINGS
// ==========================================
const char* MQTT_BROKER = "3dd5708713a94191ab75d9b92812e7bf.s1.eu.hivemq.cloud"; 
const int MQTT_PORT = 8883; 
const char* MQTT_USER = "Thesis";
const char* MQTT_PASS = "Staneychiang12";

const char* TOPIC_WEIGHT = "staney/scale/weight";
const char* TOPIC_NETWORK = "staney/scale/network";
const char* TOPIC_COMMAND = "staney/scale/command";

// ==========================================
// 2. HARDWARE & LOGIC SETTINGS
// ==========================================
const int LOADCELL_DOUT_PIN = 21;
const int LOADCELL_SCK_PIN = 22;
const float CALIBRATION_FACTOR = 461.96; 

HX711 scale;
float smoothed_weight = 0.0;
unsigned long lastMsgTime = 0;
unsigned long lastNetTime = 0;

// Stats for Packet Loss
unsigned long totalSent = 0;
unsigned long failedSent = 0;

WiFiClientSecure espClient;
PubSubClient mqttClient(espClient);

// ==========================================
// 3. MQTT CALLBACK (Remote Tare)
// ==========================================
void callback(char* topic, byte* payload, unsigned int length) {
  if (String(topic) == TOPIC_COMMAND) {
    scale.tare();
    smoothed_weight = 0.0;
    Serial.println("Scale Tared Remotely!");
  }
}

// ==========================================
// 4. CONNECTION HELPERS
// ==========================================
void reconnect() {
  while (!mqttClient.connected() && WiFi.status() == WL_CONNECTED) {
    Serial.print("Connecting to HiveMQ...");
    if (mqttClient.connect("ESP32_Scale_Client", MQTT_USER, MQTT_PASS)) {
      Serial.println("Connected!");
      mqttClient.subscribe(TOPIC_COMMAND);
    } else {
      delay(5000);
    }
  }
}

// ==========================================
// 5. MAIN EXECUTION
// ==========================================
void setup() {
  Serial.begin(115200);
  
  scale.begin(LOADCELL_DOUT_PIN, LOADCELL_SCK_PIN);
  scale.set_scale(CALIBRATION_FACTOR);
  scale.tare(); 

  // --- SECURE CAPTIVE PORTAL ---
  WiFiManager wm;
  // This pops up the UI window with password "staney123"
  if(!wm.autoConnect("Staney_Scale_Setup", "staney123")) {
      Serial.println("Setup Failed. Resetting...");
      ESP.restart();
  }

  espClient.setInsecure(); 
  mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
  mqttClient.setCallback(callback);
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    if (!mqttClient.connected()) reconnect();
    mqttClient.loop();
  }

  // Smoothing Filter (90% old, 10% new)
  float raw = scale.get_units(3);
  smoothed_weight = (0.90 * smoothed_weight) + (0.10 * raw);
  if (smoothed_weight < 2.0 && smoothed_weight > -2.0) smoothed_weight = 0.0;

  unsigned long now = millis();

  // Send Weight every 1 second
  if (now - lastMsgTime > 1000) {
    lastMsgTime = now;
    if (mqttClient.connected()) {
      totalSent++;
      String msg = String(smoothed_weight, 1);
      if (!mqttClient.publish(TOPIC_WEIGHT, msg.c_str())) failedSent++;
    }
  }

  // Send Network Stats every 5 seconds (FAILED|TOTAL|RSSI)
  if (now - lastNetTime > 5000) {
    lastNetTime = now;
    if (mqttClient.connected()) {
      String netMsg = String(failedSent) + "|" + String(totalSent) + "|" + String(WiFi.RSSI());
      mqttClient.publish(TOPIC_NETWORK, netMsg.c_str());
    }
  }
}
